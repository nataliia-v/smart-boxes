# Copy to .env.local for Next.js. Prisma CLI reads .env (or exported environment).
DATABASE_URL="postgresql://smartbox:smartbox@localhost:5432/smartbox?schema=public"
DIRECT_URL="postgresql://smartbox:smartbox@localhost:5432/smartbox?schema=public"
APP_URL="http://localhost:3000"
# Generate each secret independently: openssl rand -base64 32
AUTH_SECRET=""
TOKEN_ENCRYPTION_KEY=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Auth.js: only enable behind your trusted deployment proxy (Vercel sets this automatically).
# AUTH_TRUST_HOST="true"
